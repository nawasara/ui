{
    "name": "nawasara/ui",
    "description": "UI components, layouts, theme, and shared Livewire concerns for the Nawasara superapp framework.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "nawasara",
        "laravel",
        "livewire",
        "blade-components",
        "ui",
        "tailwind",
        "lucide"
    ],
    "authors": [
        {
            "name": "Pringgo J. Saputro",
            "email": "odyinggo@gmail.com",
            "role": "Lead Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/nawasara/ui/issues",
        "source": "https://github.com/nawasara/ui"
    },
    "autoload": {
        "psr-4": {
            "Nawasara\\Ui\\": "src/"
        },
        "files": [
            "src/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Nawasara\\Ui\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^12.0",
        "livewire/livewire": "^3.0",
        "mallardduck/blade-lucide-icons": "^1.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nawasara\\Ui\\UiServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
